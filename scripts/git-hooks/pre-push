#!/bin/bash
# Git pre-push hook for HotPlex Worker
# Final guard before code leaves the local machine
#
# Pipeline: large-file → fmt → parallel(vet, verify, lint, build) → test-short
# Expected total: ~25-35s (down from 45-60s serial)

set -e

# ANSI color codes
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf "  ${GREEN}✓${NC} %s\n" "$1"; }
fail() { FAIL=$((FAIL + 1)); printf "  ${RED}✗${NC} %s\n" "$1"; }

printf "${YELLOW}🚀 Running pre-push validation...${NC}\n"

# ── 0. Block large files (>1MB) ────────────────────────────────────────────
REMOTE_REF="$1"
LOCAL_REF="$2"

RANGE=""
if [ -n "$LOCAL_REF" ] && [ "$LOCAL_REF" != "0000000000000000000000000000000000000000" ]; then
    MERGE_BASE=$(git merge-base "$LOCAL_REF" "$REMOTE_REF" 2>/dev/null || echo "")
    if [ -n "$MERGE_BASE" ]; then
        RANGE="$MERGE_BASE..$LOCAL_REF"
    else
        RANGE="$LOCAL_REF"
    fi
fi

if [ -n "$RANGE" ]; then
    OVERSIZED=""
    while IFS= read -r blob_info; do
        size=$(echo "$blob_info" | awk '{print $3}')
        path=$(echo "$blob_info" | awk '{print $4}')
        if [ -n "$size" ] && [ "$size" -gt 1048576 ] 2>/dev/null; then
            case "$path" in
                assets/*|docs/asserts/*|docs/channels/*/guides/*) continue ;;
            esac
            OVERSIZED="$OVERSIZED\n  $path ($(( size / 1048576 ))MB)"
        fi
    done < <(git rev-list --objects "$RANGE" 2>/dev/null | git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' 2>/dev/null | awk '$1 == "blob" && $2 > 1048576 {print $0}')

    if [ -n "$OVERSIZED" ]; then
        printf "${RED}❌ Push blocked: files >1MB detected:${NC}\n"
        printf "$OVERSIZED\n"
        exit 1
    fi
fi

# ── 1. Format check (serial — modifies files) ─────────────────────────────
printf "🔹 Checking formatting...\n"
if make fmt > /dev/null 2>&1 && git diff --quiet; then
    pass "formatting"
else
    # Re-run fmt to show what changed
    make fmt > /dev/null 2>&1
    if ! git diff --quiet; then
        fail "formatting — run make fmt and commit"
        git diff --name-only
        exit 1
    fi
    pass "formatting"
fi

# ── 2. Parallel checks: vet + verify + lint + build ───────────────────────
printf "🔹 Running parallel checks (vet, verify, lint, build)...\n"

VET_RESULT=0
VERIFY_RESULT=0
LINT_RESULT=0
BUILD_RESULT=0

# Temp files for error output
VET_ERR=$(mktemp)
VERIFY_ERR=$(mktemp)
LINT_ERR=$(mktemp)
BUILD_ERR=$(mktemp)
trap 'rm -f "$VET_ERR" "$VERIFY_ERR" "$LINT_ERR" "$BUILD_ERR"' EXIT

# Run all four checks in parallel
go vet ./... > "$VET_ERR" 2>&1 &
VET_PID=$!

go mod verify > "$VERIFY_ERR" 2>&1 &
VERIFY_PID=$!

make lint > "$LINT_ERR" 2>&1 &
LINT_PID=$!

# Use go build instead of make build to skip docs/webchat
go build ./... > "$BUILD_ERR" 2>&1 &
BUILD_PID=$!

# Wait for all and collect results
wait $VET_PID || VET_RESULT=1
wait $VERIFY_PID || VERIFY_RESULT=1
wait $LINT_PID || LINT_RESULT=1
wait $BUILD_PID || BUILD_RESULT=1

if [ "$VET_RESULT" -eq 0 ]; then
    pass "go vet"
else
    fail "go vet"
    cat "$VET_ERR"
fi

if [ "$VERIFY_RESULT" -eq 0 ]; then
    pass "go mod verify"
else
    fail "go mod verify"
    cat "$VERIFY_ERR"
fi

if [ "$LINT_RESULT" -eq 0 ]; then
    pass "lint"
else
    fail "lint"
    cat "$LINT_ERR"
fi

if [ "$BUILD_RESULT" -eq 0 ]; then
    pass "build"
else
    fail "build"
    cat "$BUILD_ERR"
fi

# Fail fast if any parallel check failed
if [ "$FAIL" -gt 0 ]; then
    printf "${RED}❌ Parallel checks failed! Push aborted.${NC}\n"
    exit 1
fi

# ── 3. Fast unit tests ────────────────────────────────────────────────────
printf "🔹 Running tests...\n"
if make test-short > /dev/null 2>&1; then
    pass "tests"
else
    fail "tests"
    make test-short
    exit 1
fi

printf "${GREEN}✅ All quality gates passed! Push authorized.${NC}\n"
printf "  (%d passed, %d failed)\n" "$PASS" "$FAIL"
exit 0
