# HotPlex Worker Gateway - Environment Variables
#
# cp configs/env.example .env
#
# Load order (later overrides earlier):
#   .env → .env.local → shell environment
#
# NEVER commit .env or .env.local to version control!

# ── Required Secrets ──────────────────────────────────────────────────────────

# Admin API tokens. Referenced by config-dev.yaml as ${ADMIN_TOKEN}.
# Also supports _1..N env vars for rotation: HOTPLEX_ADMIN_TOKEN_1, HOTPLEX_ADMIN_TOKEN_2, ...
# Generate: openssl rand -hex 32
ADMIN_TOKEN=
# HOTPLEX_ADMIN_TOKEN_2=

# ── Client Authentication ─────────────────────────────────────────────────────

# API keys for client-level auth (_1..N)
# HOTPLEX_SECURITY_API_KEY_1=
# HOTPLEX_SECURITY_API_KEY_2=

# Content-Security-Policy for the embedded webchat SPA and docs portal.
# Leave empty to use the package-level default, which is INTENTIONALLY
# permissive (connect-src uses http: / https: / ws: / wss: scheme keywords,
# so any backend host is reachable without configuration). A WARN log fires
# at startup to flag the production exposure. Pin a strict directive when
# the deployment host(s) are known, e.g.:
#   HOTPLEX_SECURITY_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http://YOUR-HOST:9999 ws://YOUR-HOST:9999 wss://*; img-src 'self' data: blob:; font-src 'self' data:"

# Allowed CORS origins for gateway and admin APIs (comma-separated).
# Default: "*" (all origins). Production: pin to specific origins.
# HOTPLEX_SECURITY_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Contact URI for /.well-known/security.txt (RFC 9116).
# When set, enables the security.txt endpoint. Empty = disabled.
# HOTPLEX_SECURITY_SECURITY_CONTACT="mailto:security@example.com"

# SameSite attribute for session cookie. Options: lax, none, strict, default.
# Set to lax to support plain HTTP intranet/LAN deployments. Default: lax.
# HOTPLEX_SECURITY_COOKIE_SAME_SITE=lax

# ── Core Overrides ────────────────────────────────────────────────────────────

# Workspace root directory — the single switch for ALL HotPlex state.
# When set, config.yaml, data/, logs/, .pids/, agent-configs/, skills/,
# phrases/, the worker default work dir, and the webchat workspace sandbox
# all resolve under this directory. Unset = ~/.hotplex (legacy behavior).
# NOTE: existing data is NOT auto-migrated — move ~/.hotplex manually or
# re-run `hotplex onboard`. Explicit `--config <path>` still takes precedence.
# HOTPLEX_HOME=/data/hotplex

# Log level: debug, info, warn, error (default: info)
# HOTPLEX_LOG_LEVEL=info

# Log format: json, text (default: json)
# HOTPLEX_LOG_FORMAT=text

# File logging + rotation (default: disabled, stderr-only).
# When enabled, logs are teed to a rotated file (lumberjack). In foreground/TTY
# mode they also appear on stderr; in daemon/service mode stderr is suppressed to
# avoid duplication. All log.file.* fields require a restart to take effect.
# HOTPLEX_LOG_FILE_ENABLED=false
# HOTPLEX_LOG_FILE_PATH=                   # empty → ~/.hotplex/logs/gateway.log
# HOTPLEX_LOG_FILE_MAX_SIZE=10             # MB per file
# HOTPLEX_LOG_FILE_MAX_AGE=30              # days
# HOTPLEX_LOG_FILE_MAX_BACKUPS=100
# HOTPLEX_LOG_FILE_COMPRESS=true
# HOTPLEX_LOG_FILE_LOCAL_TIME=true

# Database path (default: data/hotplex.db)
# HOTPLEX_DB_PATH=data/hotplex.db

# Database driver: "sqlite" (default) or "postgres"
# HOTPLEX_DB_DRIVER=postgres

# PostgreSQL DSN (required when driver is "postgres")
# HOTPLEX_DB_POSTGRES_DSN=postgres://user:password@localhost:5432/hotplex?sslmode=prefer

# PostgreSQL connection pool size (default: 25)
# HOTPLEX_DB_POSTGRES_MAX_OPEN_CONNS=25

# Gateway address (default: :8888)
# HOTPLEX_GATEWAY_ADDR=:8888

# Admin address (default: :9999)
# HOTPLEX_ADMIN_ADDR=:9999

# ── Resource Limits ───────────────────────────────────────────────────────────

# HOTPLEX_SESSION_MAX_CONCURRENT=1000
# HOTPLEX_POOL_MAX_SIZE=100
# HOTPLEX_POOL_MAX_MEMORY_PER_USER=8589934592

# ── Observability ─────────────────────────────────────────────────────────────

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=hotplex-gateway

# ── Messaging (Global) ─────────────────────────────────────────────────────────

# Send turn summary after each completed turn. Default: true
# HOTPLEX_MESSAGING_TURN_SUMMARY_ENABLED=true

# ── Messaging Shared Defaults ──────────────────────────────────────────────────
# These are inherited by all platforms. Per-platform env vars below can override.

# HOTPLEX_MESSAGING_WORKER_TYPE=claude_code

# ── ACP Worker ────────────────────────────────────────────────────────────────
# Command to start ACP-compatible agent (JSON-RPC 2.0 over stdio).
# HOTPLEX_WORKER_ACP_COMMAND="hermes acp"
# HOTPLEX_WORKER_ACP_AUTO_APPROVE=true

# STT (Speech-to-Text) — shared defaults
# Provider: feishu (cloud), local (command), feishu+local (cloud+fallback), empty (disabled)
# HOTPLEX_MESSAGING_STT_PROVIDER=local
# HOTPLEX_MESSAGING_STT_LOCAL_CMD="python3 ~/.hotplex/scripts/stt_server.py"
# HOTPLEX_MESSAGING_STT_LOCAL_IDLE_TTL=1h

# TTS (Text-to-Speech) — shared defaults
# Provider: edge (Edge TTS, free), moss (MOSS-TTS-Nano local CPU),
#   edge+moss (Edge primary + MOSS fallback), empty (disabled)
# HOTPLEX_MESSAGING_TTS_ENABLED=true
# HOTPLEX_MESSAGING_TTS_PROVIDER=edge+moss
# HOTPLEX_MESSAGING_TTS_VOICE=zh-CN-XiaoxiaoNeural
# HOTPLEX_MESSAGING_TTS_MAX_CHARS=150
# HOTPLEX_MESSAGING_TTS_MOSS_MODEL_DIR=~/.hotplex/models/moss-tts-nano
# HOTPLEX_MESSAGING_TTS_MOSS_VOICE=Xiaoyu
# HOTPLEX_MESSAGING_TTS_MOSS_PORT=18083
# HOTPLEX_MESSAGING_TTS_MOSS_IDLE_TIMEOUT=30m
# HOTPLEX_MESSAGING_TTS_MOSS_CPU_THREADS=2

# ── Slack ──────────────────────────────────────────────────────────────────────

# HOTPLEX_MESSAGING_SLACK_ENABLED=true
# HOTPLEX_MESSAGING_SLACK_BOT_TOKEN=xoxb-...
# HOTPLEX_MESSAGING_SLACK_APP_TOKEN=xapp-...
# HOTPLEX_MESSAGING_SLACK_WORK_DIR=
# HOTPLEX_MESSAGING_SLACK_REQUIRE_MENTION=true
# HOTPLEX_MESSAGING_SLACK_ALLOW_FROM=
# HOTPLEX_MESSAGING_SLACK_ALLOW_DM_FROM=
# HOTPLEX_MESSAGING_SLACK_ALLOW_GROUP_FROM=

# ── Feishu ─────────────────────────────────────────────────────────────────────

# HOTPLEX_MESSAGING_FEISHU_ENABLED=true
# HOTPLEX_MESSAGING_FEISHU_APP_ID=cli_xxxxxxxxxxxx
# HOTPLEX_MESSAGING_FEISHU_APP_SECRET=
# HOTPLEX_MESSAGING_FEISHU_WORK_DIR=
# HOTPLEX_MESSAGING_FEISHU_REQUIRE_MENTION=true
# HOTPLEX_MESSAGING_FEISHU_ALLOW_FROM=
# HOTPLEX_MESSAGING_FEISHU_ALLOW_DM_FROM=
# HOTPLEX_MESSAGING_FEISHU_ALLOW_GROUP_FROM=

# ── Agent Config (Persona & Context) ───────────────────────────────────────────

# Enable loading personality (SOUL.md) and context (USER.md) from config_dir. Default: true
# HOTPLEX_AGENT_CONFIG_ENABLED=true

# Directory for .md config files. Default: ~/.hotplex/agent-configs/
# HOTPLEX_AGENT_CONFIG_DIR=~/.hotplex/agent-configs/


# ── Worker Config ─────────────────────────────────────────────────────────────
#
# Worker startup commands. Default: "claude" and "opencode".
# If you are using a custom binary name (e.g. ccr) or have multiple versions
# installed, uncomment and modify these variables.

# Binary command for Claude Code worker (default: "claude")
# TIP: If your binary is not in PATH, use absolute path: /usr/local/bin/claude
HOTPLEX_WORKER_CLAUDE_CODE_COMMAND=claude

# Binary command for OpenCode Server worker (default: "opencode")
# TIP: Use "opencode serve" if you need to pass default arguments.
HOTPLEX_WORKER_OPENCODE_SERVER_COMMAND=opencode

# HOTPLEX_WORKER_OPENCODE_SERVER_IDLE_DRAIN_PERIOD=30m

# Fallback context window size in tokens (default: 200000). OCS HTTP API does
# not expose the real model context window; set 0 to leave context_pct unset.
# HOTPLEX_WORKER_OPENCODE_SERVER_CONTEXT_WINDOW=200000

# ── Worker Environment ──────────────────────────────────────────────────────

# GitHub token for gh CLI in workers (injected via config.yaml, not shell env)
# HOTPLEX_WORKER_GH_TOKEN=ghp_xxxxxxxxxxxx
# HOTPLEX_WORKER_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
